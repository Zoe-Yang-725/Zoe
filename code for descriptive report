#function to count the number of zero observations 
#for selected variables in a data frame
count_zeros <- function(data, var_list) {
  zeros <- sapply(data[var_list], function(x) sum(x == 0, na.rm = TRUE))
  result <- data.frame(Variable = names(zeros), Num_Zero_Values = zeros, 
                       row.names = NULL)
  result
}

