#B. Advanced Descriptive Statistics:

#not only grouped by treatment condition 
#but also by individual epoch units (relative_epoch)
#providing a detailed overview of the temporal trends for each treatment condition.

#The results are visualised as mean ± 95% confidence interval plots across epochs, 
#allowing for clear comparison between treatments over the experimental period.

#this code for one variable - Acetic acid

df_summary_ace <- df_clean |>
  group_by(treatment_name, relative_epoch) |>
  summarise(
    n = n(),
    mean = mean(acetic_acid, na.rm = TRUE),
    sd = sd(acetic_acid, na.rm = TRUE),
    se = sd / sqrt(n),
    q1 = quantile(acetic_acid, 0.25, na.rm = TRUE),
    q3 = quantile(acetic_acid, 0.75, na.rm = TRUE),
    min = min(acetic_acid, na.rm = TRUE),
    max = max(acetic_acid, na.rm = TRUE),
    .groups = "drop"
  )


df_summary_ace <- df_summary_ace |>
  mutate(
    ci_l = mean - 1.96 * se,
    ci_u = mean + 1.96 * se
  )

#plot the figure with confidence interval
p_trend_ace <- ggplot(df_summary_ace, 
                      aes(x = relative_epoch, y = mean,
                          color = treatment_name, fill = treatment_name)) +
  geom_ribbon(aes(ymin = ci_l, ymax = ci_u), alpha = 0.05, color = NA) +
  geom_line() + geom_point(size=0.8) +
  labs(
    title = "Acetic acid (Mean ± 95% CI)",
    x = "Epoch (days since experiment start)",
    y = "Mean of Acetic acid (mmol/L)",
    color = "Treatment", fill = "Treatment"
  ) +
  theme_minimal()

print(p_trend_ace)

#plot the figure without confidence interval

p1_ace <- ggplot(df_summary_ace, 
                 aes(x = relative_epoch, y = mean,
                     color = treatment_name)) +
  geom_line() + geom_point(size=0.8) + 
  labs(
    title = "Acetic acid",
    x = "Epoch (days since experiment start)",
    y = "Mean of Acetic acid (mmol/L)",
    color = "Treatment", fill = "Treatment"
  ) +
  theme_minimal()

