make_summary_and_plot <- function(df, var, var_label, trend = NULL, yunit = NULL, with_ci = FALSE, caption = NULL) {
  
  df_sum <- df |>
    group_by(treatment_name, relative_epoch) |>
    summarise(
      n = n(),
      mean = mean(.data[[var]], na.rm = TRUE),
      sd = sd(.data[[var]], na.rm = TRUE),
      se = sd / sqrt(n),
      q1 = quantile(.data[[var]], 0.25, na.rm = TRUE),
      q3 = quantile(.data[[var]], 0.75, na.rm = TRUE),
      min = min(.data[[var]], na.rm = TRUE),
      max = max(.data[[var]], na.rm = TRUE),
      .groups = "drop"
    ) |>
    mutate(
      ci_l = mean - 1.96 * se,
      ci_u = mean + 1.96 * se
    )
  
  ylab <- paste0("Mean of ", var_label, if (!is.null(yunit)) paste0(" (", yunit, ")") else "")
  
  if (is.null(caption)) {
    caption <- paste0(
      #if with_ci = TRUE
      #"Each line shows the mean ± 95% CI for ", var_label, " by treatment group across epochs.",
      #"\nThe shaded area indicates the confidence interval.",
      if (!is.null(trend)) paste0("\n\nTrend: ", trend) else ""
    )
  }
  
  p <- ggplot(df_sum, aes(x = relative_epoch, y = mean, color = treatment_name, fill = treatment_name)) +
    {if (with_ci) geom_ribbon(aes(ymin = ci_l, ymax = ci_u), alpha = 0.18, color = NA)} +
    geom_line(linewidth=0.8) + geom_point(size=0.8) +
    labs(
      title = paste(var_label, if (with_ci) "(Mean ± 95% CI)" else ""),
      x = "Epoch (days since experiment start)",
      y = ylab,
      color = "Treatment", fill = "Treatment",
      caption = caption
    ) +
    theme_minimal(base_size = 14) +
    theme(plot.caption = element_text(hjust = 0, size = 11, color = "black"),
          legend.position = "bottom")
  
  list(summary = df_sum, plot = p)
}


